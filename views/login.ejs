<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="brand-mark"><span class="dot"></span> SEO Automation Suite</div>
    <p class="sub">Sign in to your workspace.</p>

    <% if (error) { %>
      <div class="notice error"><span class="notice-icon">&#9888;</span><div class="notice-body"><%= error %></div></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autofocus autocomplete="username">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn block">Sign in</button>
    </form>

    <div class="auth-foot">No account yet? <a href="/signup">Create one</a></div>
  </div>
</div>
<%- include('partials/foot') %>
