<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex, nofollow">
<title>Report unavailable</title>
<style>
  /* Standalone, with no reference to the app's stylesheet. The person reading
     this is outside the team and this page must render correctly even if the
     app's assets are unreachable - which, on a link that has already failed
     once, is not a hypothetical. */
  body {
    font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    color: #0f172a; background: #f8fafc; margin: 0;
    display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px;
  }
  .box {
    background: #fff; border: 1px solid #e5e9f0; border-radius: 10px;
    padding: 32px 34px; max-width: 460px; box-shadow: 0 1px 3px rgba(15, 23, 42, .06);
  }
  h1 { font-size: 19px; margin: 0 0 10px; }
  p { margin: 0 0 8px; color: #475569; font-size: 14px; line-height: 1.55; }
  .quiet { color: #94a3b8; font-size: 12.5px; margin-top: 16px; }
</style>
</head>
<body>
  <div class="box">
    <h1><%= heading %></h1>
    <p><%= message %></p>
    <p class="quiet">Ask whoever sent you this link for a current one.</p>
  </div>
</body>
</html>
