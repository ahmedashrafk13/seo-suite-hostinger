<%
/* The state of an AI-assisted section.

   Four states, each of which means something different and needs saying
   differently:
     unconfigured  no Azure credential — the measured half of the page is
                   unaffected, and saying so stops it reading as a failure
     budget        the spend cap was reached; an expected state, not a bug
     error         the call failed
     ok            with a note when the answer came from cache and cost nothing

   Expects `ai` = { ok, cached, reason, error, data }. */
%>
<% if (!ai) { %>
  <p class="hint mt-0">AI assistance was not requested for this run.</p>
<% } else if (ai.ok) { %>
  <p class="hint mt-0">
    <% if (ai.cached) { %>
      Generated earlier and served from cache, so this cost nothing. Tick <em>Regenerate</em> on the form to re-ask.
    <% } else { %>
      Generated by the configured Azure OpenAI model. Every measurement on this page was computed locally
      and does not depend on it.
    <% } %>
  </p>
<% } else if (ai.reason === 'unconfigured') { %>
  <div class="notice info">
    <span class="notice-icon">&#8505;</span>
    <div class="notice-body">
      <strong>No AI model configured.</strong> <%= ai.error %>
    </div>
  </div>
<% } else if (ai.reason === 'budget') { %>
  <div class="notice warn">
    <span class="notice-icon">&#9888;</span>
    <div class="notice-body">
      <strong>AI spend cap reached.</strong> <%= ai.error %>
      Raise <code>AI_LAB_SPEND_CAP_USD</code> to continue, or work from the measured findings —
      they are complete without this section.
    </div>
  </div>
<% } else { %>
  <div class="notice warn">
    <span class="notice-icon">&#9888;</span>
    <div class="notice-body">
      <strong>The AI request failed.</strong> <%= ai.error %>
      The measured findings on this page are unaffected.
    </div>
  </div>
<% } %>
