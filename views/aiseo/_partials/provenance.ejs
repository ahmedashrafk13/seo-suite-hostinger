<%
/* WHERE THESE NUMBERS CAME FROM.

   Rendered on every result page, and not optional. The whole design of this
   suite rests on never presenting an estimate as a measurement, and that
   promise is only kept if the reader can see the basis. It also states, in
   plain language, which questions the deployment cannot answer — which is more
   useful to a practitioner than a silence they have to infer.

   Expects `prov` = { used: [{key,label}], wouldImprove: [{label,note}] }. */
%>
<% if (prov) { %>
<div class="card">
  <div class="card-head"><h3>Data sources for this run</h3></div>
  <div class="card-body">
    <% if (prov.used && prov.used.length) { %>
      <p class="mt-0">
        <strong>Measured from:</strong>
        <% prov.used.forEach(function (p, i) { %><span class="chip"><%= p.label %></span><% }) %>
      </p>
    <% } %>
    <% if (prov.wouldImprove && prov.wouldImprove.length) { %>
      <p class="hint mt-0" style="margin-bottom:0">
        <strong>Not available in this deployment:</strong>
        <%= prov.wouldImprove.map(function (p) { return p.label; }).join(', ') %>.
        No credential is configured for any of them, so nothing on this page claims a search volume,
        keyword difficulty, backlink count, competitor traffic estimate or AI citation share —
        those numbers are not knowable here, and an invented one would be indistinguishable on screen
        from a real one. Adding a key activates the adapter; until then the page states its narrower basis.
      </p>
    <% } %>
  </div>
</div>
<% } %>
