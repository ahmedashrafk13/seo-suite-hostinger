  competitors: '<path d="M6.6 3.8h10.8v3.9a5.4 5.4 0 0 1-10.8 0V3.8Z"/><path d="M12 13.1v3.6M8.9 20.2h6.2"/><path d="M6.6 5.2H4.1v1.5a3.2 3.2 0 0 0 2.6 3.1"/><path d="M17.4 5.2h2.5v1.5a3.2 3.2 0 0 1-2.6 3.1"/>',
