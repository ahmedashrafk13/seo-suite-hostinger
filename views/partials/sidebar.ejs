  reports: '<path d="M6.5 3.5h7L19 9v10.5a1 1 0 0 1-1 1H6.5a1 1 0 0 1-1-1v-15a1 1 0 0 1 1-1Z"/><path d="M13.2 3.6V9H19"/><path d="M8.6 12.8h6.8M8.6 16h6.8"/>',
  leads: '<path d="M3.6 7.6h16.8v11a1.4 1.4 0 0 1-1.4 1.4H5a1.4 1.4 0 0 1-1.4-1.4v-11Z"/><path d="m3.6 8.1 8.4 5.4 8.4-5.4"/>',
  brands: '<path d="M4.2 20.4V7.6L12 3.4l7.8 4.2v12.8"/><path d="M9.4 20.4v-5.6h5.2v5.6"/><path d="M9.4 10.4h.01M12 10.4h.01M14.6 10.4h.01"/>',
  team: '<circle cx="9.2" cy="8" r="3.2"/><path d="M3.2 19.6a6 6 0 0 1 12 0"/><path d="M16.4 5.5a3.2 3.2 0 0 1 0 5"/><path d="M17.6 14.2a6 6 0 0 1 3.2 5.4"/>',
  connect: '<circle cx="12" cy="12" r="8.4"/><path d="M3.6 12h16.8"/><path d="M12 3.6a12.4 12.4 0 0 1 0 16.8 12.4 12.4 0 0 1 0-16.8Z"/>',
  settings: '<circle cx="12" cy="12" r="3"/><path d="M12 3.6v2.2M12 18.2v2.2M20.4 12h-2.2M5.8 12H3.6M17.9 6.1l-1.6 1.6M7.7 16.3l-1.6 1.6M17.9 17.9l-1.6-1.6M7.7 7.7 6.1 6.1"/>',
  workflow: '<circle cx="5.4" cy="6.2" r="2.2"/><circle cx="18.6" cy="6.2" r="2.2"/><circle cx="12" cy="17.8" r="2.2"/><path d="m7.2 7.4 3.6 8.4M16.8 7.4l-3.6 8.4"/>',
  setup: '<path d="M12 3.4v2.3M12 18.3v2.3M20.6 12h-2.3M5.7 12H3.4M18.1 5.9 16.5 7.5M7.5 16.5l-1.6 1.6M18.1 18.1l-1.6-1.6M7.5 7.5 5.9 5.9"/><circle cx="12" cy="12" r="3.1"/>',
};

function icon(name) {
  return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" '
       + 'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">'
       + (ICONS[name] || '') + '</svg>';
}

const _nc = navCounts || {};
const _isAdmin = Boolean(perms && perms.isAdmin);
const _setupLeft = (typeof setupRemaining !== 'undefined' && setupRemaining) || 0;
const _pending = (typeof pendingMembers !== 'undefined' && pendingMembers) || 0;

/* --- The single source of truth for every destination in the app ---------

   GROUPED BY THE JOB, NOT BY THE ROUTE PREFIX.
   The previous grouping had one section called "AI search" holding sixteen
   items, for no better reason than that they all live under /ai-seo. That is
   an implementation detail of this codebase, and it put the on-page score, the
   schema generator and the crawlability checks - three ordinary technical-SEO
   tools - behind a label that reads as optional, while the section itself was
   too long to scan. Meanwhile "Analyse" held keyword research, a crawler and a
   speed test, which are three different jobs.

   These sections name what you are trying to DO: understand demand, fix the
   site, improve a page, get cited, act on it, report it. Where a tool lands
   follows from that question alone, so /audit and /ai-seo/readiness sit
   together (both answer "can search engines use this site?") and /linking and
   /ai-seo/architecture sit together (both answer "do the links work?").

   ROUTES ARE UNCHANGED. Every href is the same URL it was before; only the
   grouping, the order and some labels moved. The one exception is /ai-assist,
   whose hub is now part of the AI visibility overview - the deeper
   /ai-assist/:brand/* pages are untouched and still linked from there. */
const NAV = [
  { key: 'overview', label: 'Overview', open: true, items: [
    (_isAdmin && _setupLeft > 0)
      ? { href: '/onboarding', icon: 'setup', label: 'Get started', count: _setupLeft, urgent: true,
          badgeTitle: _setupLeft + ' setup steps left' }
      : null,
    { href: '/dashboard',   icon: 'dashboard',   label: 'Dashboard', keywords: 'home overview summary' },
    { href: '/performance', icon: 'performance', label: 'Search performance', keywords: 'clicks impressions ctr position gsc ga4 traffic' },
  ] },

  /* What should we go after? Everything that sizes demand before anything is
     written or changed. */
  { key: 'research', label: 'Research and planning', open: true, items: [
    { href: '/ai-seo/research', icon: 'research',    label: 'Keyword research', keywords: 'volume difficulty ideas prompts autocomplete blended' },
    /* Next to keyword research because it answers the same question with a
       different guarantee: research blends six sources and estimates where it
       must, this is Google Ads' own data or nothing. */
    { href: '/keyword-planner', icon: 'keywords',    label: 'Keyword Planner', keywords: 'google ads volume cpc bid forecast ideas planner' },
    { href: '/keywords',        icon: 'keywords',    label: 'Keyword clusters', keywords: 'grouping topics clustering' },
    { href: '/keywords/briefs', icon: 'briefs',      label: 'Content briefs', keywords: 'outline writing brief' },
    { href: '/ai-seo/competitors', icon: 'competitors', label: 'Competitors', keywords: 'gap competitive intelligence backlink keyword gap' },
  ] },

  /* Can search engines and assistants reach, crawl and trust this site?
     Whole-site questions, all of them answered by a crawler or a Google API. */
  { key: 'health', label: 'Site health', items: [
    { href: '/audit',                 icon: 'audit', label: 'Technical audit', keywords: 'crawl health issues errors' },
    { href: '/pagespeed',             icon: 'speed', label: 'Page speed', keywords: 'core web vitals lcp cls inp lighthouse psi' },
    { href: '/ai-seo/site-readiness', icon: 'robot', label: 'Crawlability: site', keywords: 'robots sitemap noindex canonical ai crawler' },
    { href: '/ai-seo/readiness',      icon: 'robot', label: 'Crawlability: page', keywords: 'robots agent render ai crawler' },
    { href: '/ai-seo/monitoring',     icon: 'board', label: 'Tracking board', keywords: 'monitoring 404 500 ssl redirects canonicals history' },
  ] },

  /* Is this page good enough, and do the links work? Page-level and
     link-level work, which is what someone edits after the health checks. */
  { key: 'content', label: 'Content and pages', items: [
    { href: '/ai-seo/optimizer',          icon: 'optimizer', label: 'On-page score', keywords: 'content quality readability entity coverage draft' },
    { href: '/ai-seo/schema',             icon: 'schema',    label: 'Structured data', keywords: 'schema json-ld rich results markup' },
    { href: '/ai-seo/freshness',          icon: 'freshness', label: 'Content freshness', keywords: 'decay intent drift stale updating' },
    { href: '/linking',                   icon: 'linking',   label: 'Internal links', keywords: 'anchors orphans crawl linking' },
    { href: '/ai-seo/link-opportunities', icon: 'graph',     label: 'Link opportunities', keywords: 'anchor text internal links for a url' },
    { href: '/ai-seo/architecture',       icon: 'graph',     label: 'Site architecture', keywords: 'entity graph clusters hubs breadcrumbs' },
  ] },

  /* Will an assistant find, trust and cite this brand - and did any of it
     turn into traffic? The off-site and answer-engine half. */
  { key: 'visibility', label: 'AI visibility', openIfPrefix: ['/ai-assist'], items: [
    { href: '/ai-seo',                  icon: 'ai',         label: 'Overview and AI Assist', keywords: 'ai seo hub findings generate brief metadata rewrite spend' },
    { href: '/ai-seo/answer-citations', icon: 'reputation', label: 'Answer citations', keywords: 'prompts chatgpt perplexity gemini retrieval pool' },
    { href: '/ai-seo/ai-referrals',     icon: 'board',      label: 'AI referral traffic', keywords: 'ga4 sessions chatgpt perplexity copilot measured' },
    { href: '/ai-seo/brand-hub',        icon: 'briefs',     label: 'Brand hub and llms.txt', keywords: 'canonical facts entity llms.txt' },
    { href: '/ai-seo/reputation',       icon: 'reputation', label: 'Reputation signals', keywords: 'reddit hacker news press mentions' },
    { href: '/ai-seo/review-platforms', icon: 'reputation', label: 'Review platforms', keywords: 'trustpilot g2 profiles coverage' },
  ] },

  { key: 'act', label: 'Act', open: true, items: [
    { href: '/alerts', icon: 'alerts', label: 'Alerts',
      count: _nc.openAlerts, badgeTitle: _nc.openAlerts + ' unread' },
    { href: '/tasks/opportunities', icon: 'opportunities', label: 'Opportunities' },
    { href: '/tasks', icon: 'tasks', label: 'Tasks',
      count: _nc.needsApproval || _nc.openTasks,
      urgent: Boolean(_nc.needsApproval),
      badgeTitle: _nc.needsApproval ? _nc.needsApproval + ' awaiting approval' : _nc.openTasks + ' open' },
  ] },

  { key: 'deliver', label: 'Deliver', open: true, items: [
    { href: '/reports', icon: 'reports', label: 'Weekly reports' },
    /* Leads sits under Deliver rather than Analyse. It is a deliverable, and
       the only number in this app that does not come from Google, which is
       the whole reason it is worth putting in front of a client next to the
       ones that do. */
    { href: '/leads', icon: 'leads', label: 'Leads' },
  ] },

  /* No openIfPrefix needed: every one of these is an item href, and a section
     opens automatically when it holds the page you are on. */
  { key: 'setup', label: 'Setup', items: [
    { href: '/brands', icon: 'brands', label: 'Brands and sync',
      count: (navBrands && navBrands.length) || 0 },
    _isAdmin
      ? { href: '/team', icon: 'team', label: 'Team', count: _pending, urgent: Boolean(_pending),
          badgeTitle: _pending + ' waiting for approval' }
      : null,
    { href: '/connect',  icon: 'connect',  label: 'Connect Google' },
    { href: '/settings', icon: 'settings', label: 'Settings' },
    { href: '/workflow', icon: 'workflow', label: 'Workflow map' },
  ] },
].map((sec) => Object.assign({}, sec, { items: sec.items.filter(Boolean) }));

/* --- Active state: longest matching href across the whole list ----------- */
const _path = (typeof path === 'string' && path) || '';
const ACTIVE_HREF = NAV
  .reduce((all, sec) => all.concat(sec.items), [])
  .filter((it) => _path === it.href || _path.indexOf(it.href + '/') === 0)
  .sort((a, b) => b.href.length - a.href.length)
  .map((it) => it.href)[0] || '';

/* A section is open when it is marked open, when it CONTAINS the page you are
   on, or when an explicit prefix says so.

   The middle rule is the one that matters: it is derived from the same item
   list everything else reads, so a link moved between sections cannot leave a
   stale openIfPrefix behind and collapse the section you are standing in.
   openIfPrefix now only covers routes that are not themselves nav items -
   /ai-assist/:brand/* pages, reached from the AI visibility overview. */
function sectionOpen(sec) {
  if (sec.open) return true;
  if (sec.items.some((it) => _path === it.href || _path.indexOf(it.href + '/') === 0)) return true;
  const pre = sec.openIfPrefix;
  if (!pre) return false;
  return (Array.isArray(pre) ? pre : [pre]).some((x) => _path === x || _path.indexOf(x + '/') === 0);
}

function navLink(it) {
  const on = it.href === ACTIVE_HREF;
  let badge = '';
  if (it.count) {
    badge = '<span class="nav-badge' + (it.urgent ? ' urgent' : '') + '"'
          + (it.badgeTitle ? ' title="' + it.badgeTitle + '"' : '') + '>' + it.count + '</span>';
  }
  return '<a class="nav-link' + (on ? ' active' : '') + '" href="' + it.href + '"'
       + ' data-label="' + it.label + '"' + (on ? ' aria-current="page"' : '') + '>'
       + '<span class="nav-icon">' + icon(it.icon) + '</span>'
       + '<span class="nav-label">' + it.label + '</span>'
       + badge + '</a>';
}

const chev = '<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>';
%>

<a class="skip-link" href="#main">Skip to content</a>
<div class="nav-backdrop" aria-hidden="true"></div>

<nav class="sidebar" id="sidebar" aria-label="Main">

  <div class="sidebar-head">
    <a href="/dashboard" class="brand-mark" aria-label="SEO Suite home">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="3"  y="13" width="3.4" height="7"   rx="1"/>
        <rect x="10.3" y="9"  width="3.4" height="11" rx="1"/>
        <rect x="17.6" y="4"  width="3.4" height="16" rx="1"/>
      </svg>
    </a>
    <span class="brand-name">SEO Suite<small>Search operations</small></span>
    <button type="button" class="rail-toggle" aria-controls="sidebar" aria-expanded="true" aria-label="Collapse sidebar">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M15 6 9 12l6 6"/>
      </svg>
    </button>
  </div>

  <div class="nav-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5"/><path d="m19.5 19.5-4-4"/>
    </svg>
    <label class="sr-only" for="nav-filter">Filter navigation</label>
    <input type="search" id="nav-filter" placeholder="Jump to..." autocomplete="off" spellcheck="false">
    <kbd>/</kbd>
  </div>

  <div class="nav-scroll" id="nav-scroll">
    <% NAV.forEach(function (sec) { %>
      <details class="nav-section" data-key="<%= sec.key %>" <%= sectionOpen(sec) ? 'open' : '' %>>
        <summary><%= sec.label %> <%- chev %></summary>
        <div class="nav-group">
          <% sec.items.forEach(function (it) { %><%- navLink(it) %><% }) %>
        </div>
      </details>
    <% }) %>
  </div>

  <div class="sidebar-foot">
    <%
    const _u = currentUser || {};
    const _label = _u.name || _u.email || 'Account';
    const _initials = String(_label).trim().split(/[\s@._-]+/).filter(Boolean).slice(0, 2)
                        .map((w) => w[0]).join('').toUpperCase() || 'A';
    const _role = _u.role ? String(_u.role).replace(/_/g, ' ') : (_isAdmin ? 'admin' : 'member');
    %>
    <a class="sf-user" href="/settings" title="<%= _u.email || '' %>">
      <span class="avatar" aria-hidden="true"><%= _initials %></span>
      <span class="sf-text">
        <span class="sf-name"><%= _label %></span>
        <span class="sf-role"><%= _role %></span>
      </span>
    </a>
    <div class="sf-text" style="padding:6px 8px 0">
      <span style="font-size:10.5px;color:var(--chrome-text-2)">
        <a href="/privacy.html" style="color:inherit">Privacy</a> &middot;
        <a href="/terms.html" style="color:inherit">Terms</a>
      </span>
    </div>
  </div>

</nav>

<%
/* ============================================================================
   Command palette (Ctrl/Cmd+K, or "/" outside a text field).

   This, not the sidebar, is the real answer to a product with 34 destinations.
   Rendered from the same NAV list, so it lists exactly what the nav lists.

   An enhancement, never a dependency: with JavaScript off the dialog stays
   hidden and every destination in it is reachable from the nav above.
   ============================================================================ */
%>
<div class="cmdk" id="cmdk" hidden role="dialog" aria-modal="true" aria-label="Search pages">
  <div class="cmdk-panel">
    <div class="cmdk-field">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5"/><path d="m19.5 19.5-4-4"/>
      </svg>
      <label class="sr-only" for="cmdk-input">Search pages</label>
      <input type="text" id="cmdk-input" placeholder="Search pages and brands..." autocomplete="off" spellcheck="false">
      <kbd>Esc</kbd>
    </div>
    <div class="cmdk-list">
      <% NAV.forEach(function (sec) { %>
        <div class="cmdk-group">
          <div class="cmdk-grouplabel"><%= sec.label %></div>
          <% sec.items.forEach(function (it) { %>
            <a class="cmdk-item" href="<%= it.href %>" data-search="<%= it.label %> <%= sec.label %> <%= it.keywords || '' %>">
              <span class="cmdk-icon"><%- icon(it.icon) %></span>
              <span class="cmdk-label"><%= it.label %></span>
              <span class="cmdk-path"><%= it.href %></span>
            </a>
          <% }) %>
        </div>
      <% }) %>
      <% if (navBrands && navBrands.length) { %>
        <div class="cmdk-group">
          <div class="cmdk-grouplabel">Brands</div>
          <% navBrands.forEach(function (b) { %>
            <a class="cmdk-item" href="/brands/<%= b.id %>" data-search="<%= b.name %> brand">
              <span class="cmdk-icon"><%- icon('brands') %></span>
              <span class="cmdk-label"><%= b.name %></span>
              <span class="cmdk-path">Brand settings</span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </div>
    <div class="cmdk-empty" hidden><p>Nothing matches that.</p></div>
    <div class="cmdk-foot">
      <span><kbd>&uarr;</kbd><kbd>&darr;</kbd> to move</span>
      <span><kbd>Enter</kbd> to open</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </div>
</div>

<main class="main" id="main">
