<!doctype html>
<html lang="en">
<head><%- include('partials/head') %></head>
<body>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="brand-mark-row">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <rect x="3" y="13" width="3.4" height="7" rx="1"/>
          <rect x="10.3" y="9" width="3.4" height="11" rx="1"/>
          <rect x="17.6" y="4" width="3.4" height="16" rx="1"/>
        </svg>
      </span>
      <span class="bm-text">SEO Suite</span>
    </div>
    <p class="sub">Your account is waiting for approval</p>

    <div class="notice info" style="margin-bottom:16px">
      <span class="notice-icon">&#9673;</span>
      <div class="notice-body">
        You have joined <strong><%= team ? team.name : 'the team' %></strong>. An admin needs to approve your
        account before you can see any client data.
      </div>
    </div>

    <% if (admins.length) { %>
      <p class="hint" style="margin-bottom:6px">Ask one of these admins to approve you:</p>
      <ul class="tight" style="margin-bottom:16px">
        <% admins.forEach(function(a){ %>
          <li><%= a.name || a.email %> <a href="mailto:<%= a.email %>"><%= a.email %></a></li>
        <% }) %>
      </ul>
    <% } %>

    <p class="hint">Once approved, refresh this page or sign in again to reach the dashboard.</p>

    <div class="btn-row" style="margin-top:16px">
      <a class="btn secondary sm" href="/pending">Check again</a>
      <form method="POST" action="/logout" style="display:inline"><%- csrfField %>
        <button type="submit" class="btn ghost sm">Log out</button>
      </form>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
