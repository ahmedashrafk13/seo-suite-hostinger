# Copy this file to .env and fill in real values. Never commit .env.

# ---------------------------------------------------------------- server
PORT=4200
SESSION_SECRET=change-this-to-a-long-random-string

# Used in alert notifications to link back to this app. Set it to the real
# host when deploying, otherwise links in emails point at localhost.
APP_BASE_URL=http://localhost:4200

# ---------------------------------------------------------- Google OAuth
# Same OAuth client as gsc-ga4-oauth-server; add this app's redirect URI as an
# ADDITIONAL redirect URI on that client rather than replacing the old one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4200/api/auth/google/callback

# ------------------------------------------------ PageSpeed Insights (opt)
# PSI v5 works without a key at low volume; a key raises the quota. Required
# in practice if you sync Core Web Vitals for several brands.
PSI_API_KEY=

# ------------------------------------------------- notification channels
# SMTP is optional. If SMTP_HOST is unset, alert emails are printed to the
# server console instead of sent, and nothing throws.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@example.com

# Slack Incoming Webhook. A per-brand webhook set in the UI overrides this.
SLACK_WEBHOOK_URL=

# Generic JSON webhook — this is the WhatsApp path. Point it at a WhatsApp
# Business API relay (Twilio, 360dialog, Meta Cloud API) or an automation hook
# (n8n, Make, Zapier) and the alert payload is POSTed there as JSON, including
# a pre-formatted `text` field for providers that just forward a string.
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------- schedules
# Standard 5-field cron. The alert tick runs hourly and each subscription's
# own cadence (hourly/daily/weekly/monthly) decides whether it actually runs,
# so one expression serves every alert frequency.
ALERT_CRON=7 * * * *
SYNC_CRON=20 3 * * *
REPORT_CRON=30 6 * * 1

# ------------------------------------------------------------------ teams
# Set to 1 once your team is set up: sign-up then REQUIRES an invite code, so
# reaching the URL is no longer enough to create an account. People who sign
# up with a code join as PENDING and see nothing until an admin approves them
# on /team — leave this at 0 only while you are still inviting the first users.
SIGNUP_REQUIRES_INVITE=0

# --------------------------------------------------- PageSpeed Insights
# The PageSpeed Insights API does NOT accept API keys where it is enabled as a
# project service — it answers one with "API keys are not supported by this
# API. Expected OAuth2 access token…". The in-app PageSpeed page therefore
# authenticates with the SAME Google OAuth connection used for Search Console
# and GA4 (no extra scope needed), which also means requests draw on your own
# project quota instead of Google's small shared anonymous pool.
#
# Enable "PageSpeed Insights API" in the Cloud project behind GOOGLE_CLIENT_ID.
# PSI_API_KEY below is only a fallback for projects that do accept keys; leave
# it unset otherwise.
# PSI_API_KEY=

# Set to 1 to make the scheduled Monday reports include the full Search
# Console + GA4 data appendix (every synced dimension for the week, and a
# complete Excel export). Reports generated by hand have their own checkbox
# on /reports, so leave this unset unless every client hand-over needs it.
REPORT_INCLUDE_FULL_DATA=0

# ----------------------------------------------------------- Python tools
# Both crawlers are vendored under tools/ (own repo dependencies via
# `pip install -r tools/<name>/requirements.txt`; see the top-level README).
# Leave these two unset to use the vendored copies. Only set one if you are
# pointing at a different checkout of the tool during development — an unset
# or non-existent path falls back to tools/, then to the legacy sibling-folder
# layout (../internal-linking-agent, ../webtechstackdetector).
INTERNAL_LINK_AGENT_PATH=
WEBTECHSTACK_DETECTOR_PATH=
PYTHON_BIN=python

# ------------------------------------------------------- running on a URL
# Set both when the app is reachable over HTTPS (a tunnel, a reverse proxy, a
# real host). TRUST_PROXY makes Express read X-Forwarded-Proto so it knows the
# request arrived over TLS; without it, `secure` cookies are never sent and
# nobody can stay logged in.
NODE_ENV=production
TRUST_PROXY=1
# Force the secure cookie flag independently of NODE_ENV if you need to.
# COOKIE_SECURE=1

# Public base URL, used in emails and invite links.
# APP_BASE_URL=https://seo.example.com

# Assignment emails are batched: everything assigned to one person inside the
# quiet window arrives as ONE email. Raise it if your team assigns in bursts.
# ASSIGNMENT_DIGEST_QUIET_SECONDS=90
# ASSIGNMENT_DIGEST_MAX_HOLD_SECONDS=900

# ==========================================================================
# Hostinger / shared-hosting settings
# ==========================================================================
# Everything below is specific to this build. Defaults reproduce the original
# behaviour, so an existing local install needs none of it.

# ---------------------------------------------------------- writable state
# WHERE THE DATABASE LIVES. This is the setting most worth getting right.
# A Git deployment (or a re-upload) REPLACES the application folder, so a
# database left inside it is destroyed by the next deploy. Point DATA_DIR at a
# directory OUTSIDE the app folder and it survives every deployment.
#   Example on Hostinger:  /home/u123456789/seo-suite-data
DATA_DIR=
REPORTS_DIR=
TMP_DIR=

# ------------------------------------------------------------ database engine
# auto  = use the native better-sqlite3 build if it installed, else the
#         WebAssembly build (which needs no compiler). Leave this alone.
# wasm  = force the WebAssembly build.
# native= force better-sqlite3 and fail loudly if it is missing.
DB_DRIVER=auto
# How long a write waits for another process to release the database.
# SQLITE_BUSY_TIMEOUT=15000

# ------------------------------------------------------------ scheduled jobs
# REQUIRED on shared hosting, or alerts, the nightly sync, weekly reports and
# database backups never run at all.
#
# Passenger stops the app whenever it goes idle, so in-process timers belong to
# a process that no longer exists. Scheduling is driven from outside instead:
# create a cron job in hPanel that fetches this URL, and set the same secret
# here. Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_TOKEN=
# Set to 1 ONLY on a server that runs continuously (a VPS). On shared hosting
# leave it unset: the in-process scheduler cannot fire there, and enabling it
# would hide the fact that nothing is running.
# INPROCESS_CRON=1

# ------------------------------------------------------------- crawler tools
# auto   = use Python when a working interpreter with the right packages is
#          found, otherwise the bundled JavaScript ports (tools/node/).
# node   = always use the JavaScript ports. Correct for Hostinger, where there
#          is no Python to install packages into.
# python = force Python and fail if it is unusable.
TOOL_RUNTIME=auto

# Public URL of this deployment. Behind Passenger the app cannot infer its own
# https://domain, so OAuth redirects and emailed report links need it.
BASE_URL=

# =========================================================================
# AI SEO SUITE  (/ai-seo)
# =========================================================================
# The nine AI-era analyses need nothing beyond what is already configured
# above: Search Console, GA4, PageSpeed and the built-in crawler cover all of
# them, and Azure OpenAI (AZURE_OPENAI_* above) adds the AI-assisted half.
# Everything below is optional and changes what a feature CAN answer, never
# whether it runs.

# --- Reddit (works without a credential; one makes it better) ------------
# The most valuable reputation source, and the one an AI assistant leans on
# hardest when asked whether a brand can be trusted.
#
# It is scraped by src/lib/aiseo/redditClient.js, which tries four endpoints in
# order and reports which one answered. Measured against the live endpoints:
#   /search.rss   200 with real entries   <- the tier that currently works
#   /search.json  403 + an HTML block page
#   old.reddit    200, but a 302 to the login wall
#   /search/      200, but an 8KB JavaScript shell
#
# NO CREDENTIAL IS REQUIRED. Reddit does rate-limit the RSS tier though, so the
# client paces itself, backs off on a 429, retries once after the cooldown, and
# gives up cleanly while keeping what it already collected.
#
# Seconds between Reddit requests. 6 is the measured floor from this network —
# at 4s the RSS endpoint answered 429 on the second request. Raise it if scans
# report rate limits; the penalty for being too fast is a 30-240s cooldown.
# REDDIT_DELAY_MS=6000
#
# A free "script" app at https://www.reddit.com/prefs/apps buys three things
# the keyless tiers cannot: no rate limiting, real post scores and comment
# counts, and comment bodies. Optional, not required.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Reddit's API rules ask for a descriptive, unique user agent and throttle
# generic ones harder.
# REDDIT_USER_AGENT=your-company-seo-suite/1.0 (brand monitoring)

# --- optional: commercial SEO data --------------------------------------
# None of these are required, and the suite is fully functional without any of
# them. Each is a declared adapter, tried in a stated order; while its variables
# are unset the features that would use it fall back to a named, weaker basis
# and SAY SO on the page, rather than filling the gap with an estimate.
#
# The fallback chain for SEARCH VOLUME, best first:
#   GOOGLE_ADS_*   Google's own volumes, per country. START HERE.
#   DATAFORSEO_*   the same Google Ads numbers, resold.
#   SEMRUSH_API_KEY
#   (none set)     Search Console impressions — a measurement of THIS site, not
#                  a volume — plus Google Trends relative interest (0-100) for
#                  the chosen country. Both keyless, both in their own columns,
#                  neither ever printed as a search volume.
#
# The fallback chain for KEYWORD DIFFICULTY:
#   DATAFORSEO_*   a measured KD.
#   SEMRUSH_API_KEY
#   (none set)     a difficulty COMPUTED from a keyless sample of a non-Google
#                  result page, with its formula and every component shown, and
#                  labelled "proxy" in every view.
#
# The fallback chain for REFERRING DOMAINS / BACKLINKS:
#   MOZ_*          the Moz link index: complete counts, plus Domain Authority.
#   (none set)     a VERIFIED sample — candidate pages found by a keyless web
#                  search are each fetched and their outbound links read, so a
#                  domain counts only where a real link exists. Counts are
#                  floors, not totals, and are labelled as such.

# GOOGLE ADS KEYWORD PLANNER — the cheapest real volume source, and the one to
# set up first. It reuses the Google OAuth connection this app already holds, so
# the only missing pieces are a developer token (free; applied for in the Google
# Ads UI under Tools > API Center) and the manager account id to bill the API
# call against. Digits only, no dashes.
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_CUSTOMER_ID=

# Semrush: search volume, CPC, competition and keyword difficulty.
# SEMRUSH_API_KEY=
# Ahrefs: referring domains, anchor-text distribution, content gap.
# AHREFS_API_TOKEN=
# Moz: domain authority, complete referring-domain and backlink counts, spam
# score. Replaces the verified sample in the competitive backlink gap table.
# MOZ_ACCESS_ID=
# MOZ_SECRET_KEY=
# DataForSEO: live Google SERPs, measured keyword volume and difficulty, AI
# Overview presence, LLM citation tracking. Replaces the keyless SERP sample
# everywhere it is used — the difficulty proxy, the keyword gap table, and the
# on-page scorer's comparison set.
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# --- behaviour knobs ----------------------------------------------------
# Refuse all outbound calls to keyless public endpoints: Google autocomplete,
# Bing's suggestion index, the DuckDuckGo/Bing result sample, Google Trends,
# Reddit, Hacker News and news RSS.
#
# Setting this disables, and causes each to REPORT itself as disabled rather
# than empty: keyword expansion, the second suggestion index, the country-level
# relative-interest column, the keyword-difficulty proxy, the competitive
# keyword gap, the verified referring-domain sample, and the review-platform
# presence check. Everything measured from a direct fetch of the site itself
# continues to work.
# AISEO_DISABLE_PUBLIC_SOURCES=1
# How many of these analyses may run at once. Each one crawls, and shared
# hosting has a small memory allowance — three concurrent crawls is how the
# process gets killed mid-write.
# AISEO_MAX_CONCURRENT=2

# --- scheduled sweeps ---------------------------------------------------
# All three run through the same cron endpoint as the existing jobs, so no
# extra cron line is needed. Each sweeps the brand whose last sweep is
# oldest, one per tick: with N brands, each is swept every N days. Raise the
# per-tick count, or add a dedicated cron line with ?job=aiseo_tracking, for
# a brand that needs daily monitoring.
# AISEO_TRACKING_CRON=40 4 * * *
# AISEO_TRACKING_BRANDS_PER_TICK=1
# AISEO_TRACKING_SAMPLE=12
# AISEO_REPUTATION_CRON=15 5 * * *
# AISEO_REPUTATION_BRANDS_PER_TICK=1
# AISEO_FRESHNESS_CRON=10 6 * * 2
# AISEO_FRESHNESS_BRANDS_PER_TICK=2
# AISEO_FRESHNESS_PAGES=40
